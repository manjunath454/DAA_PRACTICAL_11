#include <iostream>
#include <vector>
#include <iomanip>

using namespace std;

// Use a large value to represent infinity (no path)
const int INF = 1e9;

class Graph {
private:
    int V;                          // Number of vertices
    vector<vector<int>> dist;       // Distance matrix

public:
    // Constructor
    Graph(int vertices) {
        V = vertices;
        dist.assign(V, vector<int>(V, INF));
        for (int i = 0; i < V; ++i) {
            dist[i][i] = 0; // Distance from a vertex to itself is always 0
        }
    }

    // Function to add a directed edge with a weight
    void addEdge(int u, int v, int weight) {
        dist[u][v] = weight;
        // Note: If the graph is undirected, you should also add:
        // dist[v][u] = weight;
    }

    // Floyd-Warshall Algorithm for All-Pairs Shortest Path
    void floydWarshall() {
        // Main DP loops: Consider every vertex 'k' as an intermediate node
        for (int k = 0; k < V; ++k) {
            for (int i = 0; i < V; ++i) {
                for (int j = 0; j < V; ++j) {
                    // If vertex k is on the shortest path from i to j, update dist[i][j]
                    // We also check for INF to prevent integer overflow
                    if (dist[i][k] != INF && dist[k][j] != INF && 
                        dist[i][k] + dist[k][j] < dist[i][j]) {
                        dist[i][j] = dist[i][k] + dist[k][j];
                    }
                }
            }
        }

        // Optional: Check for negative weight cycles
        for (int i = 0; i < V; ++i) {
            if (dist[i][i] < 0) {
                cout << "Graph contains a negative weight cycle!\n";
                return;
            }
        }

        printSolution();
    }

    // Helper function to print the shortest distance matrix
    void printSolution() {
        cout << "Shortest distance matrix between every pair of vertices:\n\n";
        cout << setw(8) << " ";
        for (int i = 0; i < V; ++i) {
            cout << setw(8) << "V" + to_string(i);
        }
        cout << "\n";

        for (int i = 0; i < V; ++i) {
            cout << setw(8) << "V" + to_string(i);
            for (int j = 0; j < V; ++j) {
                if (dist[i][j] == INF)
                    cout << setw(8) << "INF";
                else
                    cout << setw(8) << dist[i][j];
            }
            cout << "\n";
        }
    }
};

int main() {
    int V = 4;
    Graph g(V);

    // Adding directed edges with weights
    g.addEdge(0, 1, 3);
    g.addEdge(0, 3, 5);
    g.addEdge(1, 2, 1);
    g.addEdge(1, 3, 2);
    g.addEdge(2, 3, 4);

    g.floydWarshall();

    return 0;
}
